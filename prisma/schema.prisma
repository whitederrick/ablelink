  @@index([createdAt])
  @@map("system_announcements")
}

// 에이전시 공지 게시판 (매니저 작성 → 소속 직무지도원 열람). 알림 fan-out 없이 게시판 1행.
model AgencyAnnouncement {
  id                 BigInt   @id @default(autoincrement())
  agencyId           BigInt   @map("agency_id")
  title              String
  body               String
  type               String   @default("INFO") // (레거시 폴백) INFO | WARN | URGENT
  categoryId         BigInt?  @map("category_id") // 운영자 관리 전역 카테고리(우선). null이면 type 폴백.
  pinned             Boolean  @default(false)
  createdByManagerId BigInt?  @map("created_by_manager_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  category AnnouncementCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([agencyId, pinned, createdAt])
  @@map("agency_announcements")
