//    인력/사이트 pool 기반 매칭의 foundation
// ------------------------------------------------------

// 직종 (확장 가능 — 새 서비스 추가 시 값만 추가)
enum Profession {
  JOB_COACH // 직무지도원
  CAREGIVER // 요양보호사
  ACTIVITY_ASSISTANT // 장애인활동보호사
}

// 직종 자격 증빙 검증 상태
enum ProfessionVerifyStatus {
  PENDING  // 검증 대기 (가입/등록 직후)
  VERIFIED // 운영자 승인
  REJECTED // 반려
}

// 직무지도원/인력이 보유한 직종 자격 (다중 자격 지원)
model WorkerProfession {
  id              BigInt     @id @default(autoincrement())
  workerId        BigInt     @map("worker_id")
  profession      Profession
  certNumber      String?    @map("cert_number") // 자격증 번호
  certifiedAt     DateTime?  @map("certified_at") // 자격 취득일
  experienceYears Int        @default(0) @map("experience_years")
  isPrimary       Boolean    @default(false) @map("is_primary") // 대표 직종
  isActive        Boolean    @default(true) @map("is_active")

  // 자격 증빙·검증 (마켓플레이스 직종 증명형 가입/등록)
  certDocUrl        String?                @map("cert_doc_url") // 증빙 파일 URL
  verifyStatus      ProfessionVerifyStatus @default(PENDING) @map("verify_status")
  verifiedAt        DateTime?              @map("verified_at")
  verifiedByAdminId BigInt?                @map("verified_by_admin_id")

  createdAt       DateTime   @default(now()) @map("created_at")

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, profession])
  @@index([profession, isActive])
  @@index([verifyStatus])
  @@map("worker_professions")
}

// 인력 경력 이력
model WorkerExperience {
  id          BigInt      @id @default(autoincrement())
  workerId    BigInt      @map("worker_id")
  profession  Profession?
  orgName     String      @map("org_name") // 근무 기관/업체
  title       String? // 역할/직책
  startDate   DateTime    @map("start_date")
  endDate     DateTime?   @map("end_date")
  description String?
  createdAt   DateTime    @default(now()) @map("created_at")

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@map("worker_experiences")
}

// 인력 평점/후기 (배정 종료 후 에이전시·관리자가 평가)
model WorkerReview {
  id        BigInt   @id @default(autoincrement())
  workerId  BigInt   @map("worker_id")
  agencyId  BigInt?  @map("agency_id") // 평가 주체 에이전시
  managerId BigInt?  @map("manager_id") // 평가 작성 관리자
  createdByAdminId BigInt? @map("created_by_admin_id") // 평가 주체 운영자(공단/플랫폼)
  rating    Int // 1~5
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  worker  Worker   @relation("WorkerReviewTarget", fields: [workerId], references: [id], onDelete: Cascade)
  agency  Agency?  @relation(fields: [agencyId], references: [id])
  manager Manager? @relation(fields: [managerId], references: [id])

  @@index([workerId])
  @@index([agencyId])
  @@map("worker_reviews")
}

// ======================================================
// 직무지도 매칭 마켓플레이스 (확대 서비스, 느슨 결합 모듈)
//  - 수요측: 에이전시(Manager) 또는 시스템운영자(Admin=공단/플랫폼)가 모집 공고 등록
//  - 공급측: Worker(에이전시 없는 user 포함)가 조회·신청
//  - 매칭 성사 시 향후 SiteAssignment/계약으로 연계 (현재 서비스 편입)
// ======================================================

enum RecruitStatus {
  OPEN   // 모집중
  CLOSED // 마감
}

enum RecruitApplicationStatus {
  PENDING   // 신청(대기)
  ACCEPTED  // 수락(매칭)
  REJECTED  // 반려
  WITHDRAWN // 신청 취소
}

model RecruitPost {
  id            BigInt        @id @default(autoincrement())
  title         String                                  // 공고 제목
  companyName   String        @map("company_name")      // 사업체명
  profession    Profession    @default(JOB_COACH)        // 직종(직무지도원/요양보호사/활동지원사)
  taskName      String?       @map("task_name")         // 직무지도 과제(사업명)
  address       String                                  // 위치(주소)
  detailAddress String?       @map("detail_address")
  lat           Decimal?
  lon           Decimal?
  region        String?                                 // 검색용 지역 라벨(시/군/구)
  workHours     String?       @map("work_hours")        // 근무시간
  workDays      String?       @map("work_days")         // 근무요일
  payInfo       String?       @map("pay_info")          // 급여/수당 안내
  // 직무지도 기간(겹침 판정 기준). DB는 nullable(하위호환), API/UI에서 입력 필수 강제.
  serviceStart  DateTime?     @map("service_start")     // 직무지도 시작일
  serviceEnd    DateTime?     @map("service_end")       // 직무지도 종료일
  headcount     Int           @default(1)               // 모집 인원
  description   String?                                 // 상세 설명
  status        RecruitStatus @default(OPEN)

  // 등록 주체 (매니저=에이전시 / 운영자=공단·플랫폼)
  agencyId           BigInt?  @map("agency_id")
  createdByManagerId BigInt?  @map("created_by_manager_id")
  createdByAdminId   BigInt?  @map("created_by_admin_id")
  contactName        String?  @map("contact_name")
  contactPhone       String?  @map("contact_phone")

  // 매칭 수락 시 생성/연계된 운영 Site (방향 A 자동 배정). 첫 수락 시 생성 후 재사용(headcount>1)
  siteId        BigInt?       @map("site_id")

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  agency        Agency?       @relation(fields: [agencyId], references: [id])
  site          Site?         @relation("RecruitPostSite", fields: [siteId], references: [id])
  applications  RecruitApplication[]

  @@index([status, profession])
  @@index([agencyId])
  @@index([createdByManagerId])
  @@map("recruit_posts")
}

model RecruitApplication {
  id            BigInt                   @id @default(autoincrement())
  recruitPostId BigInt                   @map("recruit_post_id")
  workerId      BigInt                   @map("worker_id")
  message       String?                                          // 신청 메시지(자기소개 등)
  status        RecruitApplicationStatus @default(PENDING)
  decidedAt     DateTime?                @map("decided_at")       // 수락/반려 시각
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  post          RecruitPost @relation(fields: [recruitPostId], references: [id], onDelete: Cascade)
  worker        Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([recruitPostId, workerId])
  @@index([workerId, status])
  @@index([recruitPostId, status])
  @@map("recruit_applications")
}

// 방향 B: 에이전시/공단이 후보자(이력서 공개)에게 보내는 제안(컨택)
enum TalentOfferStatus {
  PENDING  // 제안 보냄(대기)
  ACCEPTED // 후보자 수락
  DECLINED // 후보자 거절
}

model TalentOffer {
  id                 BigInt            @id @default(autoincrement())
  workerId           BigInt            @map("worker_id")
  agencyId           BigInt?           @map("agency_id")
  createdByManagerId BigInt?           @map("created_by_manager_id")
  createdByAdminId   BigInt?           @map("created_by_admin_id")
  profession         Profession?                                  // 제안 직종(선택)
  siteName           String?           @map("site_name")          // 제안 현장/사업체(자유 텍스트)
  // 제안 시 연결한 실제 현장(선택). 후보자 수락 시 이 현장으로 자동 배정(방향 B).
  siteId             BigInt?           @map("site_id")
  message            String?
  // 직무지도 기간(겹침 판정·자동배정 기간 기준). DB는 nullable(하위호환), 신규 제안은 API/UI에서 입력 필수.
  serviceStart       DateTime?         @map("service_start") // 직무지도 시작일
  serviceEnd         DateTime?         @map("service_end")   // 직무지도 종료일
  status             TalentOfferStatus @default(PENDING)
  decidedAt          DateTime?         @map("decided_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  worker Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  agency Agency? @relation(fields: [agencyId], references: [id])
  site   Site?   @relation("TalentOfferSite", fields: [siteId], references: [id])

  @@index([workerId, status])
  @@index([agencyId, status])
  @@index([createdByManagerId])
  @@map("talent_offers")
}
